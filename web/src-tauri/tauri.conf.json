{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XenoClaw",
  "version": "0.1.0",
  "identifier": "dev.xeno3.xenoclaw",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "XenoClaw",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https: http: tauri:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost tauri: https: http: ws: wss:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/xeno3dev/xenoclaw/releases/latest/download/latest.json"
      ],
      "pubkey": "RWS5KY0sesMmzA4b++ksfistFq9Q1GDsy3P5pI6DT1F76abbiHjxdiGH",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "XenoClaw desktop client",
    "longDescription": "Cross-platform desktop client for the XenoClaw AI agent runtime. Connect to a remote XenoClaw server or run the backend locally as a managed sidecar.",
    "externalBin": ["binaries/xenoclaw"],
    "resources": [],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"]
      }
    }
  }
}
