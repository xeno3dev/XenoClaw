[Unit]
Description=XenoClaw AI Agent Platform
Documentation=https://github.com/xeno3ra/XenoClaw
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xenoclaw
Group=xenoclaw
WorkingDirectory=/opt/xenoclaw

# Main process
ExecStart=/opt/xenoclaw/bin/xenoclaw --config /etc/xenoclaw/config.toml

# Reload configuration without restart (sends SIGHUP to the agent process)
ExecReload=/bin/kill -HUP $MAINPID

# Auto-restart on failure (within 10 seconds as per requirement 2.7)
Restart=on-failure
RestartSec=5

# Environment configuration
Environment=XENOCLAW_CONFIG_PATH=/etc/xenoclaw/config.toml
Environment=XENOCLAW_DATA_DIR=/var/lib/xenoclaw
Environment=XENOCLAW_LOG_DIR=/var/log/xenoclaw
Environment=RUST_LOG=info

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xenoclaw-agent

# Let systemd create and chown these directories to the service user automatically.
# Resolves to /var/lib/xenoclaw, /var/log/xenoclaw, and /run/xenoclaw.
StateDirectory=xenoclaw
LogsDirectory=xenoclaw
RuntimeDirectory=xenoclaw

# Resource limits
LimitNOFILE=65536

# Security hardening
# ProtectSystem, ProtectHome, and PrivateTmp require mount namespaces and will
# fail with exit code 226/NAMESPACE inside LXC containers (Proxmox). They are
# intentionally omitted here. NoNewPrivileges works everywhere (prctl, no ns).
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
